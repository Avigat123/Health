# ==========================================
# HealthVault Backend Environment Configuration
# ==========================================

# Server Port (Render sets process.env.PORT automatically)
PORT=5000

# Allowed Frontend Origins for CORS & QR Code Share Links
# For local development: http://localhost:5173
# For production: your deployed frontend URL (e.g. https://your-healthvault-frontend.vercel.app)
# Supports comma-separated list if multiple domains are needed
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas Connection String)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/healthvault?retryWrites=true&w=majority

# Authentication Secret (Used to sign JWT tokens)
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary (File Storage for Medical Records & Scans)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini API (AI Document Classification, Summarization & Chatbot)
GEMINI_API_KEY=your_google_gemini_api_key
